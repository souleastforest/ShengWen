{
  "app": {
    "host": "0.0.0.0",
    "port": 8000,
    "enable_progress_test": false,
    "enable_mdns": false,
    "frontend_dist_dir": "frontend/dist",
    "prompt_file": "src/main/python/sheng_wen/prompt.md"
  },
  "whisper": {
    "transcriber_type": "fast_whisper",
    "model_source": "auto_download",
    "model_path": null,
    "model_size": "tiny",
    "device": "cpu",
    "enable_bilibili_subtitle_fetch": true,
    "bilibili_sessdata": "",
    "faster_whisper_model_path": null,
    "vibevoice_language_model": "Qwen/Qwen2.5-7B",
    "vibevoice_max_new_tokens": 16384,
    "vibevoice_dtype": "bfloat16",
    "vibevoice_inference_mode": "local",
    "vibevoice_api_url": "",
    "asr_chunk_threshold_sec": 600,
    "asr_chunk_duration_sec": 360,
    "asr_chunk_fallback_duration_sec": 180,
    "asr_chunk_oom_fallback": true
  },
  "llm": {
    "provider": "openai_compatible",
    "base_url": "",
    "api_key": "",
    "model_id": "",
    "temperature": 0.7,
    "context_window_size": 1000000,
    "extra_headers": null
  },
  "database": {
    "sqlite_path": "ShengWen.db",
    "json_file_path": "tasks.json",
    "backup_interval_sec": 86400,
    "backup_keep_count": 5
  },
  "cors": {
    "allow_origins": "*",
    "allow_credentials": true,
    "allow_methods": "*",
    "allow_headers": "*"
  },
  "summarization": {
    "mode": "auto",
    "auto_chunk_min_audio_duration_sec": 2400,
    "auto_chunk_min_transcript_lines": 1800,
    "chunk_target_duration_sec": 2400,
    "chunk_min_duration_sec": 1800,
    "chunk_max_duration_sec": 3000,
    "boundary_jump_sec": 10,
    "prev_tail_timestamp_lines_m": 10,
    "prev_summary_tail_chars_j": 500,
    "llm_call_retry_max": 3,
    "fallback_to_standard_on_agent_error": true,
    "chunk_prompt_file": "src/main/python/sheng_wen/prompt_for_chunk.md",
    "max_agent_value_chars": 500,
    "chunk_debug_dump_enabled": false,
    "chunk_debug_dump_dir": "temp/chunk_debug",
    "enable_agent_pipeline": false,
    "transcript_chunk_emit_duration_sec": 600
  },
  "storage": {
    "max_total_mb": 10240,
    "retention_completed_sec": 86400,
    "retention_failed_sec": 7200,
    "cleanup_interval_sec": 600,
    "base_dir": "temp"
  },
  "observability": {
    "enabled": false,
    "otlp_endpoint": "",
    "service_name": "sheng-wen",
    "trace_sample_rate": 1.0
  }
}